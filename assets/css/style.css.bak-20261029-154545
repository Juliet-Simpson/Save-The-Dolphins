:root {
    color-scheme: light;
    --ink: #153b49;
    --river-deep: #0b3d50;
    --river: #12677a;
    --water: #236e78;
    --turquoise: #2cb4be;
    --foam: #f6f6ef;
    --mist: #e7f0ed;
    --bank: #d8c9a8;
    --stone: #766d5b;
    --body-copy: #4e6267;
    --body-copy-mobile: #33474b;
    --body-copy-increase: 0rem;
    --white: #fff;
    --content-width: 72rem;
    --reading-width: 48rem;
    --page-gutter: clamp(1.25rem, 5vw, 5rem);
    font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--foam);
    font-synthesis: none;
    text-rendering: optimizeLegibility;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
}

body {
    margin: 0;
    min-width: 20rem;
    font-size: 1rem;
    line-height: 1.7;
}

img {
    display: block;
    max-width: 100%;
}

a {
    color: var(--river);
    text-underline-offset: 0.18em;
}

a:hover {
    color: var(--river-deep);
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible {
    outline: 3px solid var(--water);
    outline-offset: 4px;
}

h1,
h2,
h3,
p,
figure {
    margin-top: 0;
}

h1,
h2,
h3 {
    color: var(--river-deep);
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: -0.035em;
}

h1 {
    font-size: clamp(2.8rem, 7vw, 6.1rem);
}

h2 {
    font-size: clamp(2rem, 4.2vw, 3.8rem);
}

h3 {
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
}

.skip-link {
    position: absolute;
    z-index: 20;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.7rem 1rem;
    color: var(--white);
    background: var(--river-deep);
    transform: translateY(-150%);
}

.skip-link:focus {
    transform: translateY(0);
}

.site-header {
    position: sticky;
    z-index: 10;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 5.3rem;
    padding: 0.5rem var(--page-gutter);
    border-bottom: 1px solid rgba(21, 59, 73, 0.1);
    background: rgba(246, 246, 239, 0.97);
    backdrop-filter: blur(0.75rem);
}

.nav-toggle {
    display: none;
}

.brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
}

.brand img {
    width: auto;
    height: 3.8rem;
}

.site-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.55rem, 1.65vw, 1.5rem);
}

.site-nav a {
    padding: 0.5rem 0;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
}

.site-nav a:hover,
.site-nav a.is-current {
    color: var(--river);
}

.site-nav a.is-current {
    box-shadow: inset 0 -2px var(--water);
}

.site-nav a.nav-donate {
    padding: 0.55rem 0.9rem;
    border-radius: 0.15rem;
    color: var(--white);
    background: var(--river);
}

.site-nav a.nav-donate:hover {
    color: var(--white);
    background: var(--river-deep);
}

.home-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(46rem, calc(88svh - 5.3rem));
    padding: clamp(2rem, 5vw, 4rem) var(--page-gutter);
    overflow: hidden;
    color: var(--white);
    background-color: var(--river-deep);
    background-image: linear-gradient(90deg, rgba(8, 44, 58, 0.02) 0%, rgba(8, 44, 58, 0.06) 44%, rgba(8, 44, 58, 0.74) 100%), url("../images/home-image.png");
    background-position: left 55%;
    background-repeat: no-repeat;
    background-size: cover;
}

.hero-content {
    position: relative;
    width: min(48%, 37rem);
    margin-left: auto;
    margin-right: max(0px, calc((100vw - var(--content-width)) / 2 - var(--page-gutter)));
    text-align: right;
    text-shadow: 0 2px 5px rgba(4, 30, 39, 0.9), 0 0 18px rgba(4, 30, 39, 0.7);
}

.hero-content h1 {
    max-width: 14ch;
    margin-left: auto;
    margin-bottom: 0.9rem;
    color: var(--white);
    font-size: clamp(2.5rem, 5.4vw, 4.5rem);
}

.hero-title {
    margin-left: auto;
}

.eyebrow {
    margin-bottom: 1rem;
    color: var(--water);
    font-size: 0.74rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
}

.home-hero .eyebrow {
    color: var(--turquoise);
    text-shadow:
        0 1px 2px rgba(11, 61, 80, 0.78),
        0 2px 6px rgba(11, 61, 80, 0.58),
        0 4px 24px rgba(11, 61, 80, 0.38),
        0 0 32px rgba(11, 61, 80, 0.28);
}

@media (min-width: 901px) {
    .home-hero .eyebrow {
        font-size: 115%;
    }

    .hero-copy {
        position: relative;
        top: min(calc(2.64svh - 0.159rem), 1.38rem);
    }
}

.hero-copy {
    max-width: 31rem;
    margin-left: auto;
    margin-bottom: 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.55vw, 1.2rem);
}

.hero-actions {
    display: flex;
    width: max-content;
    max-width: calc(100% - 2 * var(--page-gutter));
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 3.1rem;
    padding: 0.75rem 1.3rem;
    border: 1px solid transparent;
    border-radius: 0.2rem;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    text-align: center;
    text-shadow: none;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}

.hero-actions .button {
    min-height: 2.7rem;
    padding: 0.6rem 1rem;
    font-size: 0.86rem;
}

.hero-actions .button-light {
    border: 2px solid var(--turquoise);
}

.home-intro .hero-actions .button-light {
    border-color: var(--river);
}

.button-light {
    color: var(--river-deep);
    background: var(--foam);
}

.button-light:hover {
    color: var(--river-deep);
    background: var(--turquoise);
}

.button-outline {
    border-color: var(--river-deep);
    color: var(--river-deep);
    background: transparent;
}

.hero-actions .button-outline {
    border-width: 2px;
}

.button-outline:hover {
    color: var(--river-deep);
    background: var(--white);
}

.button-primary {
    color: var(--white);
    background: var(--river);
}

.button-primary:hover {
    color: var(--white);
    background: var(--river-deep);
}

.section {
    padding: clamp(4rem, 8vw, 7.5rem) var(--page-gutter);
}

.section-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 0.7fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 8rem);
    max-width: calc(var(--content-width) + 2 * var(--page-gutter));
    margin-inline: auto;
}

.narrow-copy {
    max-width: 43rem;
}

.narrow-copy h2,
.section-heading h2 {
    margin-bottom: 1.2rem;
}

.narrow-copy > p:not(.eyebrow),
.section-heading > p:not(.eyebrow) {
    color: var(--body-copy);
    font-size: calc(1.08rem + var(--body-copy-increase));
}

.text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.45rem;
    font-weight: 700;
    text-decoration-thickness: 1px;
}

.fact-card {
    padding: 2rem;
    border-top: 3px solid var(--water);
    background: var(--mist);
}

.fact-mark {
    display: block;
    margin-bottom: 0.8rem;
    color: var(--water);
    font-size: 3rem;
    font-weight: 400;
    line-height: 0.8;
}

.fact-card p {
    margin-bottom: 1.2rem;
    color: var(--river-deep);
    font-size: 1.2rem;
    font-weight: 700;
}

.fact-card a {
    font-size: 0.88rem;
    font-weight: 650;
}

.section-tide {
    background: var(--mist);
}

.section-heading {
    max-width: var(--content-width);
    margin: 0 auto 2.5rem;
}

.section-heading > p:last-child {
    max-width: 43rem;
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    max-width: var(--content-width);
    margin-inline: auto;
    background: rgba(21, 59, 73, 0.16);
}

.feature-card {
    min-height: 17rem;
    padding: clamp(1.5rem, 3vw, 2.8rem);
    background: var(--mist);
}

.feature-number {
    display: block;
    margin-bottom: 2.2rem;
    color: var(--water);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.15em;
}

.feature-card h3 {
    margin-bottom: 0.9rem;
}

.feature-card p {
    color: var(--body-copy);
    font-size: calc(1rem + var(--body-copy-increase));
}

.feature-card .text-link {
    font-size: 0.9rem;
}

.section-gallery-preview {
    max-width: calc(var(--content-width) + 2 * var(--page-gutter));
    margin-inline: auto;
}

.home-intro {
    display: grid;
    grid-template-columns: minmax(14rem, 0.9fr) minmax(20rem, 1.5fr) minmax(12rem, 0.8fr);
    grid-template-areas:
        "heading copy fact"
        "actions actions actions";
    align-items: center;
    column-gap: clamp(1rem, 3vw, 3rem);
    row-gap: 0.5rem;
    padding: 2rem max(var(--page-gutter), calc((100vw - var(--content-width)) / 2));
    padding-bottom: 0.75rem;
    background: var(--mist);
}

.home-intro > * {
    min-width: 0;
}

.home-intro .hero-actions {
    grid-area: actions;
    justify-self: center;
    margin-block: 0.25rem;
}

.home-intro .hero-actions .button {
    width: 12.2rem;
}

.home-intro-heading {
    grid-area: heading;
}

.home-intro .eyebrow,
.home-gallery-heading .eyebrow,
.home-contact .contact-intro .eyebrow {
    margin-bottom: 0.45rem;
    font-size: 0.9rem;
}

.home-intro h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
}

.home-intro-copy {
    grid-area: copy;
    margin: 0;
    color: var(--body-copy);
    font-size: calc(0.95rem + var(--body-copy-increase));
}

.home-fact {
    grid-area: fact;
    margin: 0;
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--turquoise);
    color: var(--river);
    background: var(--foam);
    font-size: calc(0.9rem + 2pt);
    font-weight: 700;
}

.home-contact {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(2.5rem, 5vw, 4rem) var(--page-gutter);
    background: var(--mist);
    scroll-margin-top: 0;
}

.home-contact .contact-intro {
    margin-left: max(0px, calc((100vw - var(--content-width)) / 2 - var(--page-gutter)));
}

.home-contact .contact-intro h2 {
    margin-bottom: 0.8rem;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
}

.home-contact .contact-intro > p:last-child {
    color: var(--body-copy);
    font-size: calc(1rem + var(--body-copy-increase));
}

.home-contact .contact-form {
    max-width: 38rem;
}

.home-contact .form-field {
    margin-bottom: 0.8rem;
}

.home-contact .form-field input,
.home-contact .form-field textarea {
    padding: 0.55rem 0.75rem;
    font-size: 0.92rem;
}

.home-contact .form-field textarea {
    min-height: 6.5rem;
}

.home-contact .button {
    min-height: 2.75rem;
    padding-block: 0.55rem;
}

.home-gallery {
    padding: clamp(2.5rem, 5vw, 4rem) var(--page-gutter) 3.25rem;
    background: var(--foam);
    scroll-margin-top: 0;
}

.home-gallery .gallery-carousel {
    position: relative;
}

.home-gallery-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    max-width: var(--content-width);
    margin: 0 auto 0.5rem;
}

.home-gallery-heading .eyebrow {
    margin-bottom: 0.5rem;
}

.home-gallery-heading h2 {
    margin-bottom: 0;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
}

.gallery-expand-hint {
    margin: 0 0 0.5rem;
    color: var(--body-copy);
    font-size: calc(0.9rem + var(--body-copy-increase));
    text-align: center;
}

@media (min-width: 901px) and (max-height: 900px) {
    .home-gallery {
        padding-block: clamp(1.25rem, 3vh, 2.25rem) 3.25rem;
    }

    .home-gallery-heading {
        margin-bottom: 1rem;
    }

    .gallery-carousel {
        max-width: 68rem;
    }
}

.section-heading-inline {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
}

.section-heading-inline .text-link {
    flex: 0 0 auto;
    margin-bottom: 1.2rem;
}

.preview-image {
    display: block;
    max-width: 52rem;
    margin-inline: auto;
    padding: 0.7rem;
    background: var(--mist);
}

.preview-image img {
    width: 100%;
    max-height: 35rem;
    object-fit: contain;
}

.page-hero {
    padding: clamp(2rem, 4vw, 3.75rem) var(--page-gutter);
    background: var(--mist);
}

.about-page-hero {
    padding-top: clamp(1.3rem, 2.6vw, 2.4375rem);
    padding-bottom: clamp(1.175rem, 2.3vw, 1.84375rem);
    background-image: url("../images/about-hero-background.jpg");
    background-position: center 88%;
    background-size: cover;
}

.mission-page-hero {
    padding-bottom: calc(clamp(2rem, 4vw, 3.75rem) - 0.3rem);
    background-image: url("../images/mission-river-confluence.jpg");
    background-position: center 98%;
    background-size: cover;
}

.mission-page-hero h1 {
    color: var(--ink);
    text-shadow: 0 2px 12px rgba(255, 255, 255, 0.8);
}

.mission-page-hero .eyebrow {
    color: var(--white);
    text-shadow:
        0 1px 3px rgba(0, 0, 0, 1),
        0 3px 10px rgba(0, 0, 0, 0.92),
        0 8px 22px rgba(0, 0, 0, 0.76),
        0 16px 38px rgba(0, 0, 0, 0.56),
        0 28px 62px rgba(0, 0, 0, 0.34);
}

.page-hero.mission-page-hero > p:last-child {
    color: var(--foam);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.85), 0 6px 20px rgba(0, 0, 0, 0.6);
}

@media (min-width: 501px) {
    .mission-page-hero {
        background-position: center 93%;
    }
}

@media (max-width: 900px) {
    .about-page-hero {
        background-position: center 76%;
    }

    .page-hero.mission-page-hero > p:last-child {
        color: var(--white);
        font-weight: 400;
    }
}

.page-hero > * {
    max-width: var(--content-width);
    margin-inline: auto;
}

.page-hero .eyebrow {
    margin-bottom: 1rem;
    font-size: 0.9rem;
}

.page-hero h1 {
    margin-bottom: 1.3rem;
    font-size: clamp(2.75rem, 7vw, 5rem);
}

.about-page-hero h1 {
    font-size: clamp(2.0625rem, 5.25vw, 3.75rem);
}

.page-hero > p:last-child {
    max-width: 46rem;
    margin-left: max(var(--page-gutter), calc((100vw - var(--content-width)) / 2));
    color: var(--body-copy);
    font-size: calc(clamp(1.05rem, 2vw, 1.25rem) + var(--body-copy-increase));
}

.about-page-hero > p:last-child {
    margin-bottom: 0;
    color: var(--foam);
}

@media (min-width: 901px) {
    .about-page-hero .eyebrow {
        color: var(--ink);
        text-shadow: 0 1px 5px rgba(255, 255, 255, 0.9);
    }

    .about-page-hero h1 {
        text-shadow: 0 1px 5px rgba(255, 255, 255, 0.9);
    }
}

@media (min-width: 501px) and (max-width: 900px) {
    .about-page-hero .eyebrow {
        text-shadow: 0 1px 5px rgba(255, 255, 255, 0.9);
    }
}

.content-section {
    padding: clamp(2rem, 3.5vw, 3.25rem) var(--page-gutter);
}

.about-dolphin-section,
.about-habitat-section {
    padding-top: clamp(1.6rem, 2.8vw, 2.6rem);
}

.about-habitat-section {
    background: var(--mist);
}

.content-layout.about-habitat-layout {
    display: block;
}

.about-river-section {
    background: var(--foam);
}

.content-layout.about-river-layout {
    display: block;
    max-width: var(--content-width);
    margin-inline: auto;
}

.about-river-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 40.625%);
    grid-template-areas: "copy image";
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
}

.about-river-intro-copy {
    grid-area: copy;
}

.content-image.about-river-image {
    position: static;
    grid-area: image;
    width: 100%;
    max-width: none;
    padding: 0;
}

.about-river-intro-copy > p:last-child {
    margin-bottom: 0;
}

.about-habitat-intro {
    display: grid;
    grid-template-columns: minmax(0, 40.625%) minmax(0, 1fr);
    grid-template-areas: "image copy";
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
}

.about-habitat-intro-copy {
    grid-area: copy;
}

.content-image.about-habitat-image {
    grid-area: image;
}

.about-habitat-intro-copy > p:last-child {
    margin-bottom: 0;
}

.content-image.about-habitat-image {
    position: static;
    width: 100%;
    max-width: none;
    background: var(--mist);
}

.content-read-more {
    display: flex;
    width: fit-content;
    margin-left: auto;
    margin-top: 1.25rem;
}

.about-dolphin-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 40.625%);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
}

.about-dolphin-intro-copy > p:last-child {
    margin-bottom: 0;
}

.content-image.about-dolphin-image {
    position: static;
    width: 100%;
    max-width: none;
}

.content-details > summary {
    list-style: none;
    cursor: pointer;
}

.content-details > summary::-webkit-details-marker {
    display: none;
}

.content-details[data-expanded="true"] > summary {
    display: none;
}

.content-details-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
}

@media (min-width: 901px) {
    .about-dolphin-section,
    .about-habitat-section,
    .about-river-section {
        padding-bottom: 1.5rem;
    }

    .about-dolphin-section .content-details {
        display: block;
    }

    .about-dolphin-section .content-read-more {
        margin-right: calc(40.625% + clamp(1.5rem, 4vw, 3rem));
    }

    .about-habitat-section .content-read-more {
        margin-left: calc(40.625% + clamp(0.75rem, 2vw, 1.5rem));
        margin-right: 0;
    }

    .about-river-section .content-details {
        display: block;
    }

    .about-river-section .content-read-more {
        margin-right: calc(40.625% + clamp(1.5rem, 4vw, 3rem));
    }

    .about-river-section .content-details[data-expanded="true"] .content-details-content::before {
        display: block;
        height: 1rem;
        content: "";
    }

    .content-details-actions {
        margin-bottom: 0.9rem;
    }
}

.content-section-tint {
    background: #edf2eb;
}

.content-heading {
    max-width: var(--content-width);
    margin: 0 auto 2rem;
}

.content-heading h2 {
    margin-bottom: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
}

.content-heading .eyebrow {
    font-size: 0.9rem;
}

.species-subheading {
    margin: 1rem 0 0.5rem;
    color: var(--river-deep);
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.035em;
}

.content-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 5rem);
    max-width: var(--content-width);
    margin-inline: auto;
}

.content-layout.about-dolphin-layout {
    display: block;
    max-width: var(--content-width);
    margin-inline: auto;
}

.content-layout-reverse {
    grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1.35fr);
}

.content-layout-reverse .content-copy {
    order: 2;
}

.content-copy {
    color: #425a61;
    font-size: calc(1rem + var(--body-copy-increase));
}

.content-copy p {
    margin-bottom: 1.1rem;
}

.content-copy p:last-child {
    margin-bottom: 0;
}

.content-image {
    position: sticky;
    top: 7rem;
    margin: 0;
    padding: 0.6rem;
    background: var(--foam);
}

@media (min-width: 901px) {
    .about-dolphin-intro {
        column-gap: clamp(0.75rem, 2vw, 1.5rem);
    }

    .content-layout.about-habitat-layout {
        max-width: var(--content-width);
        margin-inline: auto;
    }

    .about-habitat-intro {
        column-gap: clamp(0.75rem, 2vw, 1.5rem);
    }

    .about-river-intro {
        column-gap: clamp(0.75rem, 2vw, 1.5rem);
    }

    .content-image.about-dolphin-image {
        padding: 0;
    }
}

.content-image img {
    width: 100%;
    height: auto;
}

@media (min-width: 901px) {
    .content-image.about-dolphin-image img {
        padding-top: 4px;
    }
}

.content-image-map img {
    max-height: 30rem;
    object-fit: contain;
}

.closing-cta {
    padding: clamp(4rem, 8vw, 7rem) var(--page-gutter);
    color: var(--white);
    text-align: center;
    background: var(--river-deep);
}

.closing-cta .eyebrow {
    color: var(--turquoise);
}

.closing-cta h2 {
    max-width: 17ch;
    margin: 0 auto 2rem;
    color: var(--white);
    font-size: clamp(2rem, 4.5vw, 3.6rem);
}

.mission-story {
    background: var(--foam);
}

.mission-emblem {
    max-width: 13rem;
    margin: 0 auto 2.5rem;
}

.mission-image img {
    max-height: 34rem;
    object-fit: contain;
}

.story-card {
    display: grid;
    grid-template-columns: 4rem minmax(0, var(--reading-width));
    gap: 1.5rem;
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(1.3rem, 4vw, 3rem);
    border-left: 3px solid var(--bank);
    background: #f0ecdf;
}

.story-mark {
    color: var(--water);
    font-size: 6rem;
    font-weight: 700;
    line-height: 0.8;
}

.contact-section {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1fr);
    gap: clamp(2rem, 8vw, 8rem);
    padding: clamp(4rem, 8vw, 7rem) var(--page-gutter);
    background: var(--mist);
    scroll-margin-top: 5.5rem;
}

.contact-intro {
    max-width: 30rem;
    margin-left: max(0px, calc((100vw - var(--content-width)) / 2 - var(--page-gutter)));
}

.contact-intro h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
}

.contact-intro > p:last-child {
    color: var(--body-copy);
    font-size: calc(1rem + var(--body-copy-increase));
}

.contact-form {
    width: 100%;
    max-width: 38rem;
}

.form-field {
    margin-bottom: 1.2rem;
}

.form-field label {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 700;
}

.form-field input,
.form-field textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid #9aadaa;
    border-radius: 0.15rem;
    color: var(--ink);
    background: var(--white);
    font: inherit;
}

.form-field textarea {
    min-height: 9rem;
    resize: vertical;
}

.form-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
}

.form-preview-note,
.form-status {
    padding: 0.8rem 1rem;
    border-left: 3px solid var(--water);
    color: var(--ink);
    background: var(--foam);
}

.form-status[data-state="error"] {
    border-color: #a34d34;
}

.source-note {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 2rem var(--page-gutter);
    color: var(--stone);
    font-size: calc(0.83rem + var(--body-copy-increase));
}

.gallery-section {
    padding: clamp(2rem, 5vw, 4rem) var(--page-gutter) clamp(4rem, 7vw, 6rem);
}

.gallery-carousel {
    max-width: 78rem;
    margin: 0 auto;
}

.gallery-stage {
    position: relative;
}

.gallery-track {
    --gallery-slide-width: 100%;
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0;
    overscroll-behavior-x: contain;
    scroll-behavior: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
}

.gallery-track::-webkit-scrollbar {
    display: none;
}

.gallery-slide {
    display: grid;
    flex: 0 0 var(--gallery-slide-width);
    place-items: center;
    height: var(--gallery-slide-height, min(70svh, 40rem));
    padding: 0;
    border: 0;
    background: transparent;
    cursor: default;
    scroll-snap-align: center;
}

.gallery-slide img {
    display: block;
    width: var(--gallery-image-width, auto);
    height: var(--gallery-image-height, auto);
    max-width: calc(100% - 8rem);
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 0.5rem 1.5rem rgba(11, 61, 80, 0.16);
    cursor: zoom-in;
}

.gallery-image-mat {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 100%;
    padding-block: clamp(1rem, 3vw, 2.5rem);
    background: var(--foam);
    cursor: zoom-in;
}

.gallery-slide:focus:not(:focus-visible) {
    outline: none;
}

.gallery-controls {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
}

.gallery-control {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
    color: var(--white);
    background: rgba(3, 17, 23, 0.58);
    cursor: pointer;
    pointer-events: auto;
    transform: translateY(-50%);
}

.gallery-control svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
}

.gallery-control:hover {
    background: rgba(3, 17, 23, 0.82);
}

.gallery-control:focus-visible {
    outline: 3px solid var(--white);
    outline-offset: 3px;
}

[data-gallery-previous] {
    left: 1rem;
}

[data-gallery-next] {
    right: 1rem;
}

.gallery-autoplay {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 50%;
    margin: 0;
    transform: translateX(-50%);
}

.gallery-play-icon {
    display: none;
}

.gallery-autoplay[data-paused="true"] .gallery-pause-icon {
    display: none;
}

.gallery-autoplay[data-paused="true"] .gallery-play-icon {
    display: block;
}

.gallery-lightbox {
    position: fixed;
    inset: 0;
    width: fit-content;
    height: fit-content;
    max-width: calc(100vw - 2rem);
    max-height: calc(100svh - 2rem);
    margin: auto;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
}

.gallery-lightbox::backdrop {
    background: rgba(3, 17, 23, 0.88);
    backdrop-filter: blur(0.4rem);
}

.gallery-lightbox img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(92vw, 85rem);
    max-height: 90svh;
    object-fit: contain;
    box-shadow: 0 1.5rem 5rem rgba(0, 0, 0, 0.55);
}

.site-footer {
    padding: 3rem var(--page-gutter) 1rem;
    color: rgba(255, 255, 255, 0.78);
    background: #102f3b;
}

.footer-main,
.footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    max-width: var(--content-width);
    margin-inline: auto;
}

.footer-main {
    padding-bottom: 2rem;
}

.footer-brand {
    color: var(--white);
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
}

.footer-main p {
    margin: 0.4rem 0 0;
    font-size: 0.86rem;
}

.footer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.3rem;
}

.footer-actions a,
.footer-bottom a {
    color: var(--white);
    font-size: 0.86rem;
    text-decoration: none;
}

.footer-actions a:hover,
.footer-bottom a:hover {
    text-decoration: underline;
}

.footer-actions a.nav-donate {
    padding: 0.55rem 0.9rem;
    border-radius: 0.15rem;
    color: var(--white);
    background: var(--river);
    font-size: 0.82rem;
    font-weight: 700;
}

.footer-actions a.nav-donate:hover {
    color: var(--white);
    background: var(--river-deep);
}

.footer-bottom {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.78rem;
}

.thank-you {
    max-width: var(--content-width);
    min-height: 55vh;
    margin-inline: auto;
    padding: clamp(5rem, 12vw, 10rem) var(--page-gutter);
}

.thank-you h1 {
    max-width: 14ch;
    font-size: clamp(2.4rem, 6vw, 4.7rem);
}

.thank-you p:not(.eyebrow) {
    margin-bottom: 2rem;
    color: var(--body-copy);
    font-size: calc(1rem + var(--body-copy-increase));
}

.redirect-message {
    max-width: 45rem;
    min-height: 70vh;
    margin-inline: auto;
    padding: 15vh var(--page-gutter);
}

@media (max-width: 900px) {
    :root {
        --body-copy: var(--body-copy-mobile);
        --body-copy-increase: 0.05rem;
    }

    .about-dolphin-section {
        padding-bottom: 1.34rem;
    }

    .about-habitat-section {
        padding-bottom: 1.34rem;
    }

    .about-dolphin-section .content-read-more,
    .about-habitat-section .content-read-more,
    .about-river-section .content-read-more {
        margin-top: 0.4rem;
        margin-inline: auto;
    }

    .content-copy {
        color: var(--body-copy-mobile);
    }

    .source-note {
        color: var(--body-copy-mobile);
    }

    .site-header {
        position: sticky;
        flex-direction: row;
        align-items: center;
        gap: 1rem;
        min-height: 4.6rem;
        padding-block: 0.5rem;
    }

    .brand img {
        height: 3.1rem;
    }

    .nav-toggle {
        display: grid;
        place-items: center;
        width: 2.9rem;
        height: 2.9rem;
        margin-left: auto;
        padding: 0;
        border: 0;
        color: var(--river-deep);
        background: transparent;
        cursor: pointer;
    }

    .nav-toggle-icon {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.28rem;
        width: 1.15rem;
        height: 1rem;
        transition: transform 220ms ease;
    }

    .nav-toggle-icon span {
        display: block;
        width: 100%;
        height: 2px;
        border-radius: 2px;
        background: currentColor;
        transition: transform 220ms ease, opacity 160ms ease;
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-icon {
        transform: rotate(90deg);
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-icon span:first-child {
        transform: translateY(0.38rem) rotate(45deg);
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-icon span:nth-child(2) {
        opacity: 0;
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-icon span:last-child {
        transform: translateY(-0.38rem) rotate(-45deg);
    }

    .site-nav {
        position: absolute;
        top: calc(100% + 1px);
        right: 0;
        left: 0;
        display: none;
        align-items: stretch;
        flex-direction: column;
        gap: 0.1rem;
        padding: 0.65rem var(--page-gutter) 1rem;
        border-bottom: 1px solid rgba(21, 59, 73, 0.15);
        background: var(--foam);
        box-shadow: 0 0.75rem 1rem rgba(11, 61, 80, 0.12);
    }

    .site-nav.is-open {
        display: flex;
    }

    .site-nav a {
        padding: 0.65rem 0;
        font-size: 0.92rem;
    }

    .site-nav a.is-current {
        box-shadow: none;
    }

    .site-nav a.nav-donate {
        align-self: flex-start;
        margin-top: 0.35rem;
        padding: 0.55rem 0.9rem;
    }

    .home-hero {
        align-items: flex-start;
        min-height: 32.3rem;
        padding: 2.5rem var(--page-gutter);
        background-image: linear-gradient(90deg, rgba(8, 44, 58, 0.02) 0%, rgba(8, 44, 58, 0.05) 48%, rgba(8, 44, 58, 0.34) 100%), url("../images/home-image.png");
        background-position: left 55%;
    }

    .hero-content {
        display: contents;
    }

    .hero-title {
        position: absolute;
        top: 11.5%;
        right: var(--page-gutter);
        left: var(--page-gutter);
        text-align: right;
    }

    .home-hero .hero-title .eyebrow {
        font-size: 110%;
    }

    .hero-title h1 {
        max-width: 14ch;
        margin-left: auto;
        margin-right: 0;
        font-size: clamp(3rem, 6vw, 4rem);
        text-shadow: 0 1px 3px rgba(4, 30, 39, 0.6);
    }

    .hero-copy {
        position: absolute;
        top: 60%;
        right: var(--page-gutter);
        width: 52%;
        max-width: 18rem;
        margin: 0;
        font-weight: 700;
        text-align: right;
        text-shadow:
            0 1px 3px rgba(0, 0, 0, 0.9),
            0 2px 12px rgba(0, 0, 0, 0.72),
            0 4px 28px rgba(0, 0, 0, 0.42),
            0 8px 46px rgba(0, 0, 0, 0.2);
    }

    .section-intro,
    .content-layout,
    .content-layout-reverse,
    .contact-section,
    .home-contact {
        grid-template-columns: 1fr;
    }

    .about-habitat-intro {
        grid-template-columns: 1fr;
        grid-template-areas:
            "image"
            "copy";
        gap: 0;
    }

    .about-river-intro {
        grid-template-columns: 1fr;
        grid-template-areas:
            "image"
            "copy";
        gap: 0;
    }

    .home-intro {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-areas:
            "heading fact"
            "copy copy"
            "actions actions";
    }

    .home-fact {
        align-self: center;
    }

    .home-contact .contact-intro {
        margin-left: 0;
    }

    .content-layout-reverse .content-copy {
        order: 0;
    }

    .content-image {
        position: static;
        max-width: 35rem;
    }

    .about-habitat-intro .content-image {
        max-width: 35rem;
        padding-inline: min(16.5%, 5.775rem);
    }

    .about-habitat-intro-copy {
        grid-area: copy;
    }

    .about-river-intro .content-image {
        max-width: 35rem;
    }

    .content-image.about-river-image {
        padding: 0 12.5% 7px;
    }

    .about-dolphin-intro {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .about-dolphin-image {
        max-width: 35rem;
        margin: 0 0 1.1rem;
    }

    .about-dolphin-intro-copy {
        grid-row: 2;
    }

    .about-dolphin-image {
        grid-row: 1;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }

    .feature-card {
        min-height: auto;
    }

    .feature-number {
        margin-bottom: 1rem;
    }

    .contact-intro {
        margin-left: 0;
    }

    html {
        scroll-padding-top: 5.3rem;
    }

    .contact-section {
        scroll-margin-top: 8rem;
    }
}

@media (max-width: 500px) {
    :root {
        --body-copy-increase: 0.1rem;
    }

    .home-hero {
        min-height: 29.682rem;
        padding: 2rem var(--page-gutter);
    }

    .content-image.about-habitat-image {
        padding-inline: min(12.5%, 4.375rem);
    }

    .hero-title {
        top: 6.25%;
    }

    .home-hero .hero-title .eyebrow {
        transform: translateY(0.35rem);
    }

    .hero-title h1 {
        font-size: clamp(2.5rem, 10vw, 3rem);
    }

    .hero-copy {
        top: 62%;
    }

    .hero-actions {
        gap: 0.55rem;
    }

    .hero-actions .button {
        min-height: 2.4rem;
        padding: 0.45rem 0.75rem;
        font-size: 0.78rem;
    }

    .home-intro {
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas:
            "heading"
            "fact"
            "copy"
            "actions";
        padding-block: 1.5rem 0.75rem;
    }

    .home-fact {
        width: 100%;
    }

    .home-gallery-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.5rem;
    }

    .gallery-slide {
        height: var(--gallery-slide-height, min(58svh, calc((100vw - 2 * var(--page-gutter)) * 0.68)));
    }

    .gallery-slide img {
        max-width: calc(100% - 6rem);
    }

    .gallery-control {
        width: 2.5rem;
        height: 2.5rem;
    }

    [data-gallery-previous] {
        left: 0.5rem;
    }

    [data-gallery-next] {
        right: 0.5rem;
    }

    .section-heading-inline,
    .footer-main,
    .footer-bottom {
        align-items: flex-start;
        flex-direction: column;
    }

    .section-heading-inline .text-link {
        margin-top: 0;
        margin-bottom: 0;
    }

    .story-card {
        grid-template-columns: 2rem minmax(0, 1fr);
        gap: 0.8rem;
    }

    .story-mark {
        font-size: 4rem;
    }

    .footer-actions {
        gap: 1rem;
    }

    html {
        scroll-padding-top: 5.3rem;
    }
}

@media (min-width: 501px) and (max-width: 900px) {
    .hero-copy {
        top: 57%;
        font-size: calc(clamp(1rem, 1.55vw, 1.2rem) + 3pt);
    }

    .content-image.about-dolphin-image {
        padding-inline: 4.2rem;
    }

    .about-habitat-intro .content-image,
    .about-river-intro .content-image {
        margin-inline: auto;
    }
}

@media (min-width: 901px) {
    .hero-copy {
        font-size: calc(clamp(1rem, 1.55vw, 1.2rem) + 3.5pt);
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}
